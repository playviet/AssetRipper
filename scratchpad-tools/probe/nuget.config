<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="SamboyDev" value="https://nuget.samboy.dev/v3/index.json" />
		<!-- Absolute. A relative "LocalPackages" resolves to probe's own directory and the restore then
		     fails with NU1102 naming a version from nuget.org. -->
		<add key="LocalPackages" value="/Users/playviet/Documents/_BZ/AssetRipper/LocalPackages" />
	</packageSources>
</configuration>
